# Backend local development / Azure App Service configuration.
# Copy to server/.env for local use. Do not commit real secrets.

NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Supabase PostgreSQL. Use the Supabase session pooler URL for App Service.
# Keep the real password in Azure App Service Configuration or local server/.env only.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=public"

# Direct database URL for Prisma migrations if needed by your migration workflow.
# Use a direct/non-pooled Supabase connection string where available.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres?schema=public"

# Use a long random value in production.
JWT_SECRET="replace-with-long-random-secret"

# Azure Communication Services Email.
AZURE_COMMUNICATION_CONNECTION_STRING="endpoint=https://<resource-name>.<region>.communication.azure.com/;accesskey=<access-key>"
AZURE_EMAIL_FROM_ADDRESS="DoNotReply@<verified-azure-email-domain>"

# Must match Azure Functions SCHEDULER_SECRET.
SCHEDULER_SECRET="replace-with-shared-scheduler-secret"
